# Database
DATABASE_URL="postgresql://username:password@localhost:5432/rentit"
DATABASE_URL_TEST="postgresql://username:password@localhost:5432/rentit_test"

# JWT
JWT_SECRET="your-secret-key-here-change-in-production"
JWT_EXPIRES_IN="30m"
JWT_REMEMBER_EXPIRES_IN="30d"

# Server
PORT=5000
FRONTEND_URL="http://localhost:5173"
# For production with multiple origins, use comma-separated values:
# FRONTEND_URL="http://localhost:5173,https://your-app.vercel.app"
NODE_ENV="development"

# Email (SMTP)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-email-password"
